# ── Only replication_package/ is public ──
# Ignore everything, then whitelist replication_package
/*
!.gitignore
!README.md
!replication_package/

# Never publish Python bytecode caches inside the whitelisted package
replication_package/**/__pycache__/

# Internal cross-check file, not part of the public package
replication_package/data/user_study/sus_individual.csv
